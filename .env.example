# Frontend (copy to frontend/.env.local when running Vite)
# Keep API relative so browser requests work through the Vite proxy and preview host.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8080
# Explicit offline fixture mode; set false for the Spring Boot-backed UI.
VITE_DEMO_MODE=true

# Backend
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/skilllink
DATABASE_USERNAME=skilllink
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key
# GitHub App (see docs/github-app-setup.md). Classic OAuth app variables are no longer used.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_NAME=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/github/callback
GITHUB_SETUP_URL=http://localhost:8080/api/v1/github/install/callback
GITHUB_WEBHOOK_SECRET=
AI_ENGINE_URL=http://localhost:8000

# AI providers are intentionally blank by default.
LLM_PROVIDER=disabled
LLM_API_KEY=
