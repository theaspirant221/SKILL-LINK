# Frontend (copy to frontend/.env.local when running Vite)
# Keep API relative so browser requests work through the Vite proxy and preview host.
VITE_API_BASE_URL=/api/v1
VITE_BACKEND_URL=http://localhost:8080
# Explicit offline fixture mode; set false for the Spring Boot-backed UI.
VITE_DEMO_MODE=true

# Backend
SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/skilllink
DATABASE_USERNAME=skilllink
DATABASE_PASSWORD=change-me
JWT_SECRET=replace-with-a-long-random-secret
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:5173/api/v1/github/callback
AI_ENGINE_URL=http://localhost:8000

# AI providers are intentionally blank by default.
LLM_PROVIDER=disabled
LLM_API_KEY=
